@@ -4,7 +4,8 @@ version = "0.1.0"
 edition = "2024"
 
 [lib]
-crate-type = ["dylib"]
+# rlib so Galexy can link Cranelift into rustc. There is no dynamic loader.
+crate-type = ["rlib"]
 
 [dependencies]
 # These have to be in sync with each other
@@ -41,6 +42,28 @@ smallvec = "1.8.1"
 
 #gimli = { path = "../" }
 
+# Galexy links this crate into rustc. The extern crates above are
+# rustc_private and are not in the stage0 sysroot for this target, so
+# they have to be real path dependencies. The host dylib build still
+# loads them from the sysroot and must not take this edge (it would
+# cycle through rustc_interface on a normal bootstrap).
+[target.'cfg(target_os = "galexy")'.dependencies]
+rustc_abi = { path = "../rustc_abi" }
+rustc_ast = { path = "../rustc_ast" }
+rustc_attr_ir = { path = "../rustc_attr_ir" }
+rustc_codegen_ssa = { path = "../rustc_codegen_ssa" }
