diff --git a/compiler/rustc/src/main.rs b/compiler/rustc/src/main.rs
index 6609a19fa..3e09a2d18 100644
--- a/compiler/rustc/src/main.rs
+++ b/compiler/rustc/src/main.rs
@@ -34,5 +34,18 @@
 rustc_driver::override_c_allocator_in_binary!();
 
 fn main() -> ExitCode {
+    #[cfg(target_os = "galexy")]
+    {
+        // The process stack is four pages. Parsing and the compile thread
+        // need the 17 MiB `DEFAULT_STACK_SIZE`; move there before any work.
+        return std::thread::Builder::new()
+            .name("rustc-main".to_string())
+            .stack_size(17 * 1024 * 1024)
+            .spawn(rustc_driver::main)
+            .expect("rustc thread")
+            .join()
+            .unwrap_or_else(|_| ExitCode::from(101));
+    }
+    #[cfg(not(target_os = "galexy"))]
     rustc_driver::main()
 }
