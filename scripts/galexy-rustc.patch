@@ -0,0 +1,37 @@
+//! Galexy.OS. Mirrors `targets/x86_64-unknown-galexy.json` in the Galexy
+//! tree: static, large code model, soft-float, no TLS, no dynamic linking.
+//! The image base is still a link argument (`--image-base`), not a spec field.
+
+use crate::spec::{
+    Arch, Cc, CodeModel, LinkerFlavor, Lld, Os, PanicStrategy, RelocModel, RustcAbi, Target,
+    TargetMetadata, TargetOptions,
+};
+
+pub(crate) fn target() -> Target {
+    Target {
+        llvm_target: "x86_64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("Galexy.OS".into()),
+            tier: Some(3),
+            host_tools: Some(true),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        arch: Arch::X86_64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        options: TargetOptions {
+            os: Os::Other("galexy".into()),
+            cpu: "x86-64".into(),
+            features: "-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,+soft-float".into(),
+            max_atomic_width: Some(64),
+            linker: Some("rust-lld".into()),
+            linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+            panic_strategy: PanicStrategy::Abort,
+            relocation_model: RelocModel::Static,
+            code_model: Some(CodeModel::Large),
+            rustc_abi: Some(RustcAbi::Softfloat),
+            ..Default::default()
+        },
+    }
+}
