+//! Segmented stacks need `mmap`. Galexy tasks already have a fixed stack,
+//! so the parser just runs the closure where it is.
+
+#[inline(always)]
+pub fn maybe_grow<R, F: FnOnce() -> R>(_red_zone: usize, _stack_size: usize, callback: F) -> R {
+    callback()
+}
+
+pub fn grow<R, F: FnOnce() -> R>(_stack_size: usize, callback: F) -> R {
+    callback()
+}
