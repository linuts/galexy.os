+
+        #[pymethod]
+        fn readable(&self, vm: &VirtualMachine) -> PyResult<bool> {
+            let state = self.lock(vm)?;
+            if state.file.is_none() {
+                return Err(io_closed_error(vm));
+            }
+            Ok(state.readable)
+        }
+
+        #[pymethod]
+        fn writable(&self, vm: &VirtualMachine) -> PyResult<bool> {
+            let state = self.lock(vm)?;
+            if state.file.is_none() {
+                return Err(io_closed_error(vm));
+            }
+            Ok(state.writable)
+        }
+
+        #[pymethod]
+        fn seekable(&self, vm: &VirtualMachine) -> PyResult<bool> {
+            let state = self.lock(vm)?;
+            if state.file.is_none() {
+                return Err(io_closed_error(vm));
+            }
+            Ok(true)
+        }
+
+        #[pymethod]
+        fn readinto(
+            zelf: &Self,
+            buffer: ArgMemoryBuffer,
+            vm: &VirtualMachine,
+        ) -> PyResult<usize> {
+            let mut state = zelf.lock(vm)?;
+            if state.file.is_none() {
+                return Err(io_closed_error(vm));
+            }
+            if !state.readable {
+                return Err(new_unsupported_operation(
+                    "File or stream is not readable",
+                    vm,
+                ));
+            }
+            let file = state.file.as_mut().unwrap();
+            let mut buf = buffer.borrow_buf_mut();
+            file.read(&mut buf).map_err(|err| io_error(zelf, err, vm))
+        }
+
+        #[pymethod]
+        fn write(zelf: &Self, data: ArgBytesLike, vm: &VirtualMachine) -> PyResult<usize> {
+            let bytes = data.borrow_buf();
+            let mut state = zelf.lock(vm)?;
+            if state.file.is_none() {
+                return Err(io_closed_error(vm));
+            }
+            if !state.writable {
+                return Err(new_unsupported_operation(
+                    "File or stream is not writable",
+                    vm,
+                ));
+            }
+            let append = state.append;
+            let file = state.file.as_mut().unwrap();
+            if append {
+                file.seek(SeekFrom::End(0))
+                    .map_err(|err| io_error(zelf, err, vm))?;
+            }
+            file.write_all(&bytes)
+                .map_err(|err| io_error(zelf, err, vm))?;
