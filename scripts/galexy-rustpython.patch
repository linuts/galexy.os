@@ -9,6 +9,50 @@
 #[must_use]
 pub fn os_random<const N: usize>() -> [u8; N] {
     let mut buf = [0u8; N];
-    getrandom::fill(&mut buf).unwrap();
+    #[cfg(target_os = "galexy")]
+    {
+        // `getrandom`'s rdrand backend returns NO_RDRAND on this guest
+        // ("instruction not supported"). A hash seed is not a secret.
+        // Mix `Clock` (syscall 27) the way the PAL's fallback does.
+        fill_from_clock(&mut buf);
+    }
+    #[cfg(not(target_os = "galexy"))]
+    {
+        getrandom::fill(&mut buf).unwrap();
+    }
     buf
 }
+
+#[cfg(target_os = "galexy")]
+fn fill_from_clock(buf: &mut [u8]) {
+    let ticks = clock_ms().unwrap_or(0);
+    let mut state = ticks ^ (buf.as_ptr().addr() as u64) ^ 0x9E37_79B9_7F4A_7C15;
+    for chunk in buf.chunks_mut(8) {
+        state ^= state >> 12;
+        state ^= state << 25;
+        state ^= state >> 27;
+        state = state.wrapping_mul(0x2545_F491_4F6C_DD1D);
+        let bytes = state.to_ne_bytes();
+        chunk.copy_from_slice(&bytes[..chunk.len()]);
+    }
+}
+
+#[cfg(target_os = "galexy")]
+fn clock_ms() -> Result<u64, ()> {
+    let value: u64;
+    let ok: u64;
+    // SAFETY: syscall 27 is `Clock`. rcx and r11 are clobbered.
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") 27u64 => value,
+            inlateout("rdx") 0u64 => ok,
+            in("rdi") 0u64,
+            in("rsi") 0u64,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack),
+        );
+    }
+    if ok != 0 { Ok(value) } else { Err(()) }
+}
