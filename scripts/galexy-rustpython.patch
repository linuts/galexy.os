@@ -0,0 +1,45 @@
+//! Run one Python file on the Galexy RustPython VM.
+//!
+//! `python PATH` reads the file and executes it with builtins and `sys`.
+//! There is no REPL and no network.
+
+use rustpython_vm::{Interpreter, Settings, compiler};
+
+fn main() {
+    galexy_libcalls::keep();
+    let mut argv: Vec<String> = std::env::args().collect();
+    if argv.len() < 2 {
+        eprintln!("usage: python FILE");
+        std::process::exit(2);
+    }
+    let path = argv[1].clone();
+    let source = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(err) => {
+            eprintln!("python: {path}: {err}");
+            std::process::exit(1);
+        }
+    };
+    // sys.argv is the script and whatever followed it.
+    argv.remove(0);
+
+    let mut settings = Settings::default();
+    settings.argv = argv;
+    let interp = Interpreter::without_stdlib(settings);
+    let code = interp.enter(|vm| {
+        let scope = vm.new_scope_with_builtins();
+        let code = match vm.compile(&source, compiler::Mode::Exec, path) {
+            Ok(code) => code,
+            Err(err) => {
+                let exc = err.into_pyexception(vm, Some(&source));
+                vm.print_exception(&exc);
+                std::process::exit(1);
+            }
+        };
+        if let Err(exc) = vm.run_code_obj(code, scope) {
+            vm.print_exception(&exc);
+            std::process::exit(1);
+        }
+    });
+    let _ = code;
+}
