diff --git a/crates/galexy-python/src/main.rs b/crates/galexy-python/src/main.rs
new file mode 100644
index 0000000..7d72cf0
--- /dev/null
+++ b/crates/galexy-python/src/main.rs
@@ -0,0 +1,444 @@
+//! Run one Python file on the Galexy RustPython VM.
+//!
+//! `python PATH` reads the file and executes it with builtins and `sys`.
+//! `python` with no path is a REPL: `>>> `, one statement at a time,
+//! `exit()` or Ctrl-D leaves. An import whose top-level name is not in
+//! `allow.txt` is `ImportError` and the process exits non-zero.
+//! `open` and `io.open` are `_io.open`.
+
+use rustpython_vm::{Interpreter, Settings, VirtualMachine, compiler};
+
+/// Same names as `scripts/python-allow.txt`. The build copies that file
+/// over this one before it links.
+const ALLOW: &str = include_str!("../allow.txt");
+
+fn main() {
+    galexy_libcalls::keep();
+    // The leader stack is four pages at image+1GiB. Milestone 93 wrote
+    // the guard under it (`err=0x6`, `rip=0xc8001ac8472`,
+    // `cr2=0xc803ffffa70`). A `thread::Builder` request for 17 MiB came
+    // up as 64 pages, so switch RSP onto a heap buffer of that size.
+    #[cfg(target_os = "galexy")]
+    {
+        const STACK: usize = 17 * 1024 * 1024;
+        let layout = std::alloc::Layout::from_size_align(STACK, 16).expect("stack layout");
+        let ptr = unsafe { std::alloc::alloc(layout) };
+        if ptr.is_null() {
+            eprintln!("python: stack allocation failed");
+            std::process::exit(1);
+        }
+        let top = (ptr as usize).saturating_add(STACK) & !0xF;
+        let code = unsafe { call_on_stack(top, python_main) };
+        unsafe { std::alloc::dealloc(ptr, layout) };
+        std::process::exit(code);
+    }
+    #[cfg(not(target_os = "galexy"))]
+    std::process::exit(python_main());
+}
+
+/// Call `f` with RSP at `top` (`top` is 16-byte aligned).
+///
+/// # Safety
+///
+/// `top` addresses a writable buffer that extends at least as far down as
+/// `f` will grow the stack.
+#[cfg(target_os = "galexy")]
+unsafe fn call_on_stack(top: usize, f: fn() -> i32) -> i32 {
+    let code: i32;
+    // SAFETY: caller guarantees `top`. The callee is a Rust `fn` and
+    // returns in `eax`.
+    unsafe {
+        core::arch::asm!(
+            "mov {saved}, rsp",
+            "mov rsp, {top}",
+            "call {func}",
+            "mov rsp, {saved}",
+            saved = out(reg) _,
+            top = in(reg) top,
+            func = in(reg) f,
+            lateout("rax") code,
+            lateout("rcx") _,
+            lateout("rdx") _,
+            lateout("rsi") _,
+            lateout("rdi") _,
+            lateout("r8") _,
+            lateout("r9") _,
+            lateout("r10") _,
+            lateout("r11") _,
+        );
+    }
+    code
+}
+
+fn python_main() -> i32 {
+    let mut argv: Vec<String> = std::env::args().collect();
+    if argv.len() < 2 {
+        return repl_main(argv);
+    }
+    let path = argv[1].clone();
+    let source = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(err) => {
+            eprintln!("python: {path}: {err}");
+            return 1;
+        }
+    };
+    // sys.argv is the script and whatever followed it.
+    argv.remove(0);
+
+    let mut settings = Settings::default();
+    settings.argv = argv;
+    // Text files are UTF-8. There is no locale encoding.
+    settings.utf8_mode = 1;
+    let interp = Interpreter::without_stdlib(settings);
+    let mut status = 0;
+    interp.enter(|vm| {
+        let scope = vm.new_scope_with_builtins();
+        let prelude = allow_prelude();
+        if let Err(exc) = run(vm, &prelude, scope.clone(), "<galexy>") {
+            vm.print_exception(&exc);
+            status = 1;
+            return;
+        }
+        let ran = run(vm, &source, scope, &path);
+        // Unreferenced files flush here, the way a refcounted close would.
+        vm.state.gc.collect_force(2);
+        if let Err(exc) = ran {
+            vm.print_exception(&exc);
+            status = 1;
+        }
+    });
+    status
+}
+
+fn repl_main(argv: Vec<String>) -> i32 {
+    let mut settings = Settings::default();
+    settings.argv = argv;
+    settings.utf8_mode = 1;
+    let interp = Interpreter::without_stdlib(settings);
+    let mut status = 0;
+    interp.enter(|vm| {
+        let scope = vm.new_scope_with_builtins();
+        let prelude = allow_prelude();
+        if let Err(exc) = run(vm, &prelude, scope.clone(), "<galexy>") {
+            vm.print_exception(&exc);
+            status = 1;
+            return;
+        }
+        repl(vm, scope);
+    });
+    status
+}
+
+/// Read a line, compile it as one interactive statement, print the
+/// exception, and keep going. `exit()` and Ctrl-D return to the shell.
+fn repl(vm: &VirtualMachine, scope: rustpython_vm::scope::Scope) {
+    println!("galexy python");
+    let mut pending = String::new();
+    loop {
+        let prompt = if pending.is_empty() { ">>> " } else { "... " };
+        print!("{prompt}");
+        let _ = std::io::Write::flush(&mut std::io::stdout());
+        let Some(line) = read_console_line() else {
+            println!();
+            return;
+        };
+        if pending.is_empty() && (line == "exit" || line == "exit()") {
+            return;
+        }
+        pending.push_str(&line);
+        pending.push('\n');
+        if needs_more(&pending) {
+            continue;
+        }
+        let source = std::mem::take(&mut pending);
+        if let Err(exc) = run_interactive(vm, &source, scope.clone()) {
+            vm.print_exception(&exc);
+        }
+        vm.state.gc.collect_force(2);
+    }
+}
+
+fn run_interactive(
+    vm: &VirtualMachine,
+    source: &str,
+    scope: rustpython_vm::scope::Scope,
+) -> rustpython_vm::PyResult {
+    let code = vm
+        .compile(source, compiler::Mode::Single, "<stdin>".to_owned())
+        .map_err(|err| err.into_pyexception(vm, Some(source)))?;
+    vm.run_code_obj(code, scope)
+}
+
+/// A line that ends with `:`, or still has an open bracket or quote,
+/// waits for the `...` continuation. This is not the full Python grammar.
+fn needs_more(src: &str) -> bool {
+    let mut paren = 0i32;
+    let mut bracket = 0i32;
+    let mut brace = 0i32;
+    let mut quote: Option<char> = None;
+    for c in src.chars() {
+        if let Some(q) = quote {
+            if c == q {
+                quote = None;
+            }
+            continue;
+        }
+        match c {
+            '\'' | '"' => quote = Some(c),
+            '(' => paren += 1,
+            ')' => paren -= 1,
+            '[' => bracket += 1,
+            ']' => bracket -= 1,
+            '{' => brace += 1,
+            '}' => brace -= 1,
+            _ => {}
+        }
+    }
+    paren > 0 || bracket > 0 || brace > 0 || quote.is_some() || src.trim_end().ends_with(':')
+}
+
+/// Echoed line from the seat keyboard. `None` is Ctrl-D on an empty line.
+///
+/// Backspace is BS or DEL and deletes the character before the cursor.
+/// Left and right are `ESC [ C`/`D`, `ESC [ <n> C`/`D`, and `ESC O C`/`D`.
+fn read_console_line() -> Option<String> {
+    use std::io::{Read, Write};
+    let mut line = String::new();
+    let mut pos = 0usize;
+    let mut byte = [0u8; 1];
+    let mut input = std::io::stdin();
+    let mut output = std::io::stdout();
+    let mut phase = 0u8;
+    let mut num: u16 = 0;
+    let mut semi = false;
+    loop {
+        if input.read(&mut byte).ok()? == 0 {
+            return None;
+        }
+        match py_key(&mut phase, &mut num, &mut semi, byte[0]) {
+            PyAct::More => {}
+            PyAct::Submit => {
+                let _ = output.write_all(b"\n");
+                let _ = output.flush();
+                return Some(line);
+            }
+            PyAct::Eof => {
+                if line.is_empty() {
+                    return None;
+                }
+            }
+            PyAct::Backspace => {
+                if pos > 0 && pos <= line.len() {
+                    pos -= 1;
+                    line.remove(pos);
+                    py_paint_backspace(&mut output, &line, pos);
+                }
+            }
+            PyAct::Left => {
+                if pos > 0 {
+                    pos -= 1;
+                    py_move(&mut output, 1, b'D');
+                }
+            }
+            PyAct::Right => {
+                if pos < line.len() {
+                    pos += 1;
+                    py_move(&mut output, 1, b'C');
+                }
+            }
+            PyAct::Char(b) => {
+                if pos > line.len() {
+                    pos = line.len();
+                }
+                line.insert(pos, b as char);
+                pos += 1;
+                py_paint_insert(&mut output, &line, pos);
+            }
+        }
+    }
+}
+
+enum PyAct {
+    More,
+    Submit,
+    Eof,
+    Backspace,
+    Left,
+    Right,
+    Char(u8),
+}
+
+fn py_key(phase: &mut u8, num: &mut u16, semi: &mut bool, byte: u8) -> PyAct {
+    match *phase {
+        1 => {
+            if byte == b'[' {
+                *phase = 2;
+                *num = 0;
+                *semi = false;
+                return PyAct::More;
+            }
+            if byte == b'O' {
+                *phase = 3;
+                return PyAct::More;
+            }
+            if byte == 0x1b {
+                return PyAct::More;
+            }
+            *phase = 0;
+            py_ground(byte)
+        }
+        2 => match byte {
+            b'0'..=b'9' => {
+                if !*semi {
+                    *num = num.saturating_mul(10).saturating_add((byte - b'0') as u16);
+                }
+                PyAct::More
+            }
+            b';' => {
+                *semi = true;
+                PyAct::More
+            }
+            0x1b => {
+                *phase = 1;
+                PyAct::More
+            }
+            0x20..=0x3f => PyAct::More,
+            b'D' => {
+                *phase = 0;
+                PyAct::Left
+            }
+            b'C' => {
+                *phase = 0;
+                PyAct::Right
+            }
+            b'~' if *num == 3 => {
+                *phase = 0;
+                PyAct::Backspace
+            }
+            b'u' if *num == 8 || *num == 127 => {
+                *phase = 0;
+                PyAct::Backspace
+            }
+            _ => {
+                *phase = 0;
+                PyAct::More
+            }
+        },
+        3 => {
+            *phase = 0;
+            match byte {
+                b'D' => PyAct::Left,
+                b'C' => PyAct::Right,
+                _ => PyAct::More,
+            }
+        }
+        _ => {
+            if byte == 0x1b {
+                *phase = 1;
+                return PyAct::More;
+            }
+            py_ground(byte)
+        }
+    }
+}
+
+fn py_ground(byte: u8) -> PyAct {
+    match byte {
+        b'\n' | b'\r' => PyAct::Submit,
+        0x04 => PyAct::Eof,
+        0x08 | 0x7f => PyAct::Backspace,
+        b if b.is_ascii_graphic() || b == b' ' => PyAct::Char(b),
+        _ => PyAct::More,
+    }
+}
+
+fn py_paint_backspace(output: &mut impl std::io::Write, line: &str, pos: usize) {
+    if pos == line.len() {
+        let _ = output.write_all(b"\x08 \x08");
+        let _ = output.flush();
+        return;
+    }
+    py_move(output, 1, b'D');
+    let tail = line.get(pos..).unwrap_or("");
+    let _ = output.write_all(tail.as_bytes());
+    let _ = output.write_all(b" ");
+    py_move(output, tail.len() + 1, b'D');
+}
+
+fn py_paint_insert(output: &mut impl std::io::Write, line: &str, pos: usize) {
+    if pos == 0 {
+        return;
+    }
+    let ch = line.as_bytes()[pos - 1];
+    let _ = output.write_all(&[ch]);
+    let tail = line.get(pos..).unwrap_or("");
+    if tail.is_empty() {
+        let _ = output.flush();
+        return;
+    }
+    let _ = output.write_all(tail.as_bytes());
+    py_move(output, tail.len(), b'D');
+}
+
+fn py_move(output: &mut impl std::io::Write, n: usize, dir: u8) {
+    if n == 0 {
+        return;
+    }
+    let mut raw = [0u8; 16];
+    raw[0] = 0x1b;
+    raw[1] = b'[';
+    let mut tmp = [0u8; 8];
+    let mut t = tmp.len();
+    let mut v = n;
+    while v > 0 && t > 0 {
+        t -= 1;
+        tmp[t] = b'0' + (v % 10) as u8;
+        v /= 10;
+    }
+    let digits = &tmp[t..];
+    raw[2..2 + digits.len()].copy_from_slice(digits);
+    let end = 2 + digits.len();
+    raw[end] = dir;
+    let _ = output.write_all(&raw[..=end]);
+    let _ = output.flush();
+}
+
+fn run(
+    vm: &rustpython_vm::VirtualMachine,
+    source: &str,
+    scope: rustpython_vm::scope::Scope,
+    path: &str,
+) -> rustpython_vm::PyResult {
+    let code = vm
+        .compile(source, compiler::Mode::Exec, path.to_owned())
+        .map_err(|err| err.into_pyexception(vm, Some(source)))?;
+    vm.run_code_obj(code, scope)
+}
+
+/// Install the allow-list finder, then alias `io` to `_io`.
+fn allow_prelude() -> String {
+    let names: Vec<&str> = ALLOW
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with('#'))
+        .collect();
+    let set = names
+        .iter()
+        .map(|name| format!("{name:?}"))
+        .collect::<Vec<_>>()
+        .join(", ");
+    format!(
+        "import sys as _sys\n\
+         _ALLOW = {{{set}}}\n\
+         class _Allow:\n\
+         \tdef find_spec(self, fullname, path=None, target=None):\n\
+         \t\ttop = fullname.split('.')[0]\n\
+         \t\tif top not in _ALLOW:\n\
+         \t\t\traise ImportError('module %r is not allowed' % (fullname,))\n\
+         \t\treturn None\n\
+         _sys.meta_path.insert(0, _Allow())\n\
+         import _io as io\n\
+         _sys.modules['io'] = io\n"
+    )
+}
