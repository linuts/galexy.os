+            }
+            if !args.closefd {
+                return Err(vm.new_value_error("Cannot use closefd=False with file name"));
+            }
+            let mode = args.mode.as_ref().map(|m| m.as_str()).unwrap_or("r");
+            let parsed = parse_mode(mode).map_err(|err| vm.new_value_error(err))?;
+            let path = OsPath::try_from_object(vm, args.file.clone())?;
+            let path_str = path.to_string_lossy();
+            let mut opts = std::fs::OpenOptions::new();
+            opts.read(parsed.readable);
+            opts.write(parsed.writable);
+            if parsed.append {
+                opts.append(true);
+            }
+            if parsed.truncate {
+                opts.truncate(true);
+            }
+            if parsed.create_new {
+                opts.create_new(true);
+            } else if parsed.create {
+                opts.create(true);
+            }
+            let opened = opts.open(path_str.as_ref()).map_err(|err| {
+                let exc = err.into_pyexception(vm);
