index 0000000..e6cea2e
--- /dev/null
+++ b/galexy/libcalls/src/lib.rs
@@ -0,0 +1,52 @@
+//! Cranelift lowers some f64 rounding to the C libcall `nearbyint`.
+//! This target has no C library, so the symbol is defined here.
+//! Rounding is ties-to-even, which is the default IEEE mode.
+
+/// Referenced from the interpreter so this crate stays on the link line.
+pub fn keep() {}
+
+#[no_mangle]
+pub extern "C" fn nearbyint(x: f64) -> f64 {
+    soft_nearbyint(x)
+}
+
+#[no_mangle]
+pub extern "C" fn rint(x: f64) -> f64 {
+    soft_nearbyint(x)
+}
+
+fn soft_nearbyint(x: f64) -> f64 {
+    if !x.is_finite() {
+        return x;
+    }
+    let bits = x.to_bits();
+    let neg = bits >> 63 != 0;
+    let exp = ((bits >> 52) & 0x7ff) as i32;
+    let frac = bits & ((1u64 << 52) - 1);
+    let unbiased = exp - 1023;
+    let apply = |mag: f64| -> f64 {
+        let mut out = mag.to_bits();
+        if neg {
+            out |= 1u64 << 63;
+        }
+        f64::from_bits(out)
+    };
+    if unbiased >= 52 {
+        return x;
+    }
+    if unbiased < -1 {
+        return apply(0.0);
+    }
+    if unbiased == -1 {
+        return if frac == 0 { apply(0.0) } else { apply(1.0) };
+    }
+    let shift = (52 - unbiased) as u32;
+    let significand = (1u64 << 52) | frac;
+    let half = 1u64 << (shift - 1);
+    let frac_bits = significand & ((1u64 << shift) - 1);
+    let mut integer = significand >> shift;
+    if frac_bits > half || (frac_bits == half && (integer & 1) == 1) {
+        integer += 1;
+    }
+    apply(integer as f64)
+}
