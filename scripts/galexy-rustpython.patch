+    use std::io::{Read, Seek, SeekFrom, Write};
+
+    use super::{
+        _io::{
+            get_offset, iobase_close, io_closed_error, new_unsupported_operation,
+            repr_file_obj_name, HowArg, _RawIOBase,
+        },
+        iobase_finalize, Offset,
+    };
+    use crate::{
+        AsObject, Py, PyObject, PyObjectRef, PyResult, VirtualMachine,
+        builtins::PyUtf8StrRef,
+        convert::{IntoPyException, TryFromObject},
+        function::{ArgBytesLike, ArgMemoryBuffer},
+        ospath::OsPath,
+        types::{Constructor, DefaultConstructor, Destructor, Initializer, Representable},
+    };
+
+    #[derive(Debug)]
+    struct State {
+        file: Option<std::fs::File>,
+        readable: bool,
+        writable: bool,
+        append: bool,
+        mode: String,
+    }
+
+    impl Default for State {
+        fn default() -> Self {
+            Self {
+                file: None,
+                readable: false,
+                writable: false,
+                append: false,
+                mode: String::new(),
+            }
+        }
+    }
+
+    struct ParsedMode {
+        readable: bool,
+        writable: bool,
+        append: bool,
+        truncate: bool,
+        create: bool,
+        create_new: bool,
+    }
+
+    fn parse_mode(mode: &str) -> Result<ParsedMode, String> {
+        let mut saw = false;
+        let mut plus = false;
+        let mut readable = false;
+        let mut writable = false;
+        let mut append = false;
+        let mut truncate = false;
+        let mut create = false;
+        let mut create_new = false;
+        for c in mode.chars() {
+            match c {
+                'r' | 'w' | 'a' | 'x' if saw => {
+                    return Err(
+                        "Must have exactly one of create/read/write/append mode and at most one plus"
+                            .to_owned(),
+                    );
+                }
+                'r' => {
+                    saw = true;
+                    readable = true;
+                }
+                'w' => {
+                    saw = true;
+                    writable = true;
+                    create = true;
+                    truncate = true;
+                }
+                'a' => {
+                    saw = true;
+                    writable = true;
+                    append = true;
+                    create = true;
+                }
+                'x' => {
+                    saw = true;
+                    writable = true;
+                    create_new = true;
+                }
+                '+' if plus => {
+                    return Err(
+                        "Must have exactly one of create/read/write/append mode and at most one plus"
+                            .to_owned(),
+                    );
+                }
+                '+' => plus = true,
+                'b' => {}
+                _ => return Err(format!("invalid mode: {mode}")),
+            }
+        }
+        if !saw {
+            return Err(
+                "Must have exactly one of create/read/write/append mode and at most one plus"
+                    .to_owned(),
+            );
+        }
+        if plus {
+            readable = true;
+            writable = true;
+        }
+        Ok(ParsedMode {
+            readable,
+            writable,
+            append,
+            truncate,
+            create,
+            create_new,
+        })
+    }
+
+    fn io_error(
+        zelf: &Py<FileIO>,
+        error: std::io::Error,
+        vm: &VirtualMachine,
+    ) -> crate::builtins::PyBaseExceptionRef {
+        let exc = error.into_pyexception(vm);
+        if let Ok(name) = zelf.as_object().get_attr("name", vm) {
+            let _ = exc.as_object().set_attr("filename", name, vm);
+        }
+        exc
+    }
+
+    #[pyattr]
+    #[pyclass(module = "_io", name, base = _RawIOBase)]
+    #[derive(Debug)]
+    pub(super) struct FileIO {
+        _base: _RawIOBase,
+        state: std::sync::Mutex<State>,
+    }
+
+    #[derive(FromArgs)]
+    pub(super) struct FileIOArgs {
+        #[pyarg(any)]
+        file: PyObjectRef,
+        #[pyarg(any, default, py_default = "'r'")]
+        mode: Option<PyUtf8StrRef>,
+        #[pyarg(any, default = true)]
+        closefd: bool,
+        #[pyarg(any, optional)]
+        opener: Option<PyObjectRef>,
