+    impl Representable for FileIO {
+        #[inline]
+        fn repr_str(zelf: &Py<Self>, vm: &VirtualMachine) -> PyResult<String> {
+            let type_name = zelf.class().slot_name();
+            let closed = zelf
+                .state
+                .lock()
+                .map(|state| state.file.is_none())
+                .unwrap_or(true);
+            if closed {
